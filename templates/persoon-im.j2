{% extends "impl.j2" %}

{% block metainfo %}
<div class="head" role="metainfo" id="metainfo">
     <dl>
        <dt>Brondata</dt>
        <dd>
           <a href="https://github.com/Informatievlaanderen/OSLOthema-persoon/tags/{{ data.metadata.branchtag }}">https://github.com/Informatievlaanderen/OSLOthema-persoon/tags/{{ data.metadata.branchtag }}</a>
        </dd>
        <dt>Changelog</dt>
        <dd>
           <a href="https://implementatie.data.vlaanderen.be/doc/implementatiemodel/magda/persoon/{{ data.metadata.branchtag }}/resources/artefacts/CHANGELOG.md">https://implementatie.data.vlaanderen.be/doc/implementatiemodel/magda/persoon/{{ data.metadata.branchtag }}/resources/artefacts/CHANGELOG.md</a>
        </dd>
        <dt>Opmerkingen en feedback</dt>
        <dd>
           <a href="{{ data.metadata.feedbackurl }}">{{ data.metadata.feedbackurl }}</a>
        </dd>
        <dd>
           <a href="{{ data.metadata.standaardregisterurl }}">{{ data.metadata.standaardregisterurl }}</a>
        </dd>
        {% if data.metadata.dependencies %}
           <dt>Afhankelijkheden</dt>
           <dd>
              {% for dep in metadata.dependencies %}
                 <a href="{{ dep.packageurl }}">{{ dep.packagelabel }}</a>
              {% endfor %}
           </dd>
        {% endif %}
     </dl>
</div>

{% endblock %}


{% block summary %}
<p></p>
{% endblock %}
