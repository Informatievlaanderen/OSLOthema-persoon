{
  "openapi": "3.0.4",
  "info": {
    "title": "MAGDA persoon.personen REST",
    "version": "0.3.0",
    "contact": {
        "name": "MAGDA Service Desk",
        "url": "https://vlaamseoverheid.atlassian.net/servicedesk/customer/portal/2038"
    },
    "license": {
        "name": "Gebruiksvoorwaarden",
        "url": "https://vlaamseoverheid.atlassian.net/wiki/spaces/MG/pages/1093927442/Persoon.GeefPersoon-02.02#Gebruiksvoorwaarden"
    }
  },
  "servers": [
    {
      "url": "api/v1/persoon",
      "description": "Basis URL"
    }
  ],
  "components": {
    "schemas": {
      "PersonEnvelope": { "$ref": "components.json#/components/schemas/PersonEnvelope" }
    }
  },
  "paths": {
    "/personen": {
      "get": {
        "summary": "Persoon waarvan de gegevens zijn ingeschreven in een register.",
        "description": "Persoon waarvan de gegevens zijn ingeschreven in een register.",
        "operationId": "PersoonGET",
        "parameters": [
          {
            "name": "X-INSZ",
            "required": true,
            "in": "header",
            "description": "INSZ van een GeregistreerdPersoon object.",
            "schema": {
              "type": "string",
              "pattern": "^\\d{11}$"
            }
          },
          {
            "name": "X-Correlation-Id",
            "required": true,
            "in": "header",
            "description": "Correlatie ID van het request.",
            "schema": {
              "type": "string",
              "minLength": 10,
              "maxLength": 36
            }
          },
          {
            "name": "source",
            "required": true,
            "in": "query",
            "description": "Bron die geraadpleegd moet worden om de Persoon op te vragen.",
            "schema": {
              "type": "string",
              "pattern": "^(RR|KSZ)$"
            },
            "examples": {
              "RR": {
                "summary": "Rijksregister (OVO027248)",
                "value": "RR"
              },
              "KSZ": {
                "summary": "Kruispuntbank van de Sociale Zekerheid (OVO008218)",
                "value": "KSZ"
              }
            }
          },
          {
            "name": "embed",
            "required": false,
            "in": "query",
            "description": "Extra ITs die moeten worden opgevraagd die niet standaard bij de bron worden meegegeven. Indien niet meegegeven zal deze extra informatie niet in het antwoord zitten.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(Afstamming|AfstammingDalendeLijn)$"
              }
            },
            "examples": {
              "IT110": {
                "summary": "Afstamming (IT 110)",
                "value": ["Afstamming"]
              },
              "IT114": {
                "summary": "Afstamming in dalende lijn (IT 114)",
                "value": ["AfstammingDalendeLijn"]
              },
              "IT110-IT114": {
                "summary": "Afstamming (IT 110) en Afstamming in dalende lijn (IT 114)",
                "value": ["Afstamming", "AfstammingDalendeLijn"]
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "GeregistreerdPersoon object gevonden.",
            "content": {
              "application/ld+json": {
                "schema": { "$ref": "components.json#/components/schemas/PersonEnvelope" }
              }
            }
          },
          "400": {
            "description": "Invalid data supplied.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "components.json#/components/schemas/Problemdetail"
                }
              }
            },
            "links": {
              "Problemdetail.type": {
                "operationId": "PersoonGET",
                "parameters": {
                  "type": "$response.body#/type"
                },
                "description": "De waarde van het attribuut `type` kan gebruikt worden om het gerefereerde object van het type `ProblemDetails` op te halen."
              }
            }
          },
          "401": {
            "description": "Invalid authorization.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "components.json#/components/schemas/Problemdetail"
                }
              }
            },
            "links": {
