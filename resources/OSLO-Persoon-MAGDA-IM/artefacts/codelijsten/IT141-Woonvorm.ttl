@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.

<https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm/v1> a skos:ConceptScheme;
    skos:prefLabel "Codelijst IT141 Woonvorm (v1)"@nl;
    skos:definition "Codelijst van woonvormen uit Informatie Type 141 'Gezinslid'."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm>;
    skos:notation "Woonvorm-v1".
<https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm> a skos:ConceptScheme;
    skos:prefLabel "Codelijst IT141 Woonvorm"@nl;
    skos:definition "Codelijst van woonvormen uit Informatie Type 141 'Gezinslid'."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/IT141>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/IT141>;
    skos:notation "Woonvorm".
<https://data.vlaanderen.be/id/concept/IT141/Woonvorm/v1/00> a skos:Concept;
    skos:prefLabel "Gewone gezinssamenstelling"@nl;
    skos:definition "Normale gezinssamenstelling binnen Belgie, of een gezin in het buitenland."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm/v1>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm/v1>;
    skos:notation "00".
<https://data.vlaanderen.be/id/concept/IT141/Woonvorm/v1/01> a skos:Concept;
    skos:prefLabel "Zorgwonen (Vlaams Gewest)"@nl;
    skos:definition "Zorgwonen in het Vlaams Gewest is het creëren van een kleinere woongelegenheid in of bij een bestaande woning zodat maximaal twee oudere of hulpbehoevende personen kunnen inwonen. Om een zorgwoning te creëren moet de eigendom, of ten minste de blote eigendom van de hoofd- en de ondergeschikte wooneenheid aan dezelfde eigenaar toebehoren."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm/v1>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm/v1>;
    skos:notation "01".
<https://data.vlaanderen.be/id/concept/IT141/Woonvorm/v1/02> a skos:Concept;
    skos:prefLabel "Collectief wonen (Waals Gewest)"@nl;
    skos:definition "Het gezin verblijft in een woning in het Waals gewest met verschillende wooneenheden waarbij ze hetzelfde huisnummer delen."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm/v1>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm/v1>;
    skos:notation "02".
<https://data.vlaanderen.be/id/concept/IT141/Woonvorm/v1/03> a skos:Concept;
    skos:prefLabel "Collectief wonen (Brussels Gewest)"@nl;
    skos:definition "Het gezin verblijft in een woning in het Brussels gewest met verschillende wooneenheden waarbij ze hetzelfde huisnummer delen."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm/v1>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm/v1>;
    skos:notation "03".
<https://data.vlaanderen.be/id/concept/IT141/Woonvorm/v1/05> a skos:Concept;
    skos:prefLabel "Tijdelijke opvang"@nl;
    skos:definition "Gezin dat tijdelijk is opgevangen bij een pleeggezin die een deel van hun woning afstaan als tijdelijk verblijf voor het opgevangen gezin."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm/v1>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm/v1>;
    skos:notation "05".
<https://data.vlaanderen.be/id/concept/IT141/Woonvorm/v1/UITZONDERING> a skos:Concept;
    skos:prefLabel "Onbekende code"@nl;
    skos:definition "De code is nog niet gekend bij MAGDA voor 'IT141 Woonvorm'. Contacteer MAGDA via de Servicedesk."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm/v1>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/IT141/Woonvorm/v1>;
    skos:notation "UITZONDERING".
