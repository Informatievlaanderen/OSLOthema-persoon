@prefix skos: <http://www.w3.org/2004/02/skos/core#>.

<https://data.vlaanderen.be/id/conceptscheme/IT026/RedenAfwezigheid> a skos:ConceptScheme;
    skos:prefLabel "Codelijst IT026 Reden afwezigheid"@nl;
    skos:definition "Codelijst van de redenen om tijdelijk afwezig te zijn in Informatie Type 026 'Tijdelijke Afwezigheid'."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/IT026>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/IT026>;
    skos:notation "RedenAfwezigheid".
<https://data.vlaanderen.be/id/conceptscheme/IT026> a skos:ConceptScheme;
    skos:prefLabel "Codelijst IT026"@nl;
    skos:definition "Codelijst van Informatie Type 026 'Tijdelijke Afwezigheid'."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/MAGDA/Persoon>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/MAGDA/Persoon>;
    skos:notation "IT026".
<https://data.vlaanderen.be/id/conceptscheme/MAGDA/Persoon> a skos:ConceptScheme;
    skos:prefLabel "Codelijsten Implementatiemodel MAGDA Persoon"@nl;
    skos:definition "Codelijsten toegepast in de implementatie van Persoon bij MAGDA volgens het Implementatiemodel MAGDA Persoon."@nl;
    skos:notation "MAGDA-Persoon".
