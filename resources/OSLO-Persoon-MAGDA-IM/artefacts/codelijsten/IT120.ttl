<https://data.vlaanderen.be/id/conceptscheme/IT120> a skos:ConceptScheme;
    skos:prefLabel "Codelijst IT120"@nl;
    skos:definition "Codelijst van Informatie Type 120 'Burgerlijke staat'."@nl;
