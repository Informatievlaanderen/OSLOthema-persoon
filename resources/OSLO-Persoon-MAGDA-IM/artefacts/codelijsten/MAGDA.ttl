@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.

<https://data.vlaanderen.be/id/conceptscheme/MAGDA/Persoon> a skos:ConceptScheme;
    skos:prefLabel "Codelijsten Implementatiemodel MAGDA Persoon"@nl;
    skos:definition "Codelijsten toegepast in de implementatie van Persoon bij MAGDA volgens het Implementatiemodel MAGDA Persoon."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/MAGDA>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/MAGDA>;
    skos:notation "MAGDA-Persoon".
<https://data.vlaanderen.be/id/conceptscheme/MAGDA> a skos:ConceptScheme;
    skos:prefLabel "MAGDA codelijsten"@nl;
    skos:definition "Alle codelijsten die specifiek zijn voor de MAGDA diensten."@nl;
    skos:notation "MAGDA".
