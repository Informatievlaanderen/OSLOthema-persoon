    skos:prefLabel "Codelijst IT024"@nl;
    skos:definition "Codelijst van Informatie Type 024 'Referentieadres'."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/MAGDA/Persoon>;
