<https://data.vlaanderen.be/id/concept/IT001/AdministratiefBeheerdertype/v1/Gemeente> a skos:Concept;
    skos:prefLabel "Gemeente"@nl;
    skos:definition "De administratief beheerder van het dossier is een Belgische gemeente."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/IT001/AdministratiefBeheerdertype/v1>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/IT001/AdministratiefBeheerdertype/v1>;
