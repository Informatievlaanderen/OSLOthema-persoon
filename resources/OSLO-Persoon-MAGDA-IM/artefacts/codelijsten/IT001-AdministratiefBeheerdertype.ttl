<https://data.vlaanderen.be/id/conceptscheme/IT001/AdministratiefBeheerdertype/v1> a skos:ConceptScheme;
    skos:prefLabel "Codelijst IT001 Administratief beheerder types (v1)"@nl;
    skos:definition "Codelijst van de administratief beheerder types in Informatie Type 001 'Gemeente van verblijf'."@nl;
