@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.

<https://data.vlaanderen.be/id/conceptscheme/IT020/DomicilieStatus> a skos:ConceptScheme;
    skos:prefLabel "Codelijst IT020 Domicilie status"@nl;
    skos:definition "Codelijst van de status van een domicilie in Informatie Type 020 'Adres van de hoofdverblijfplaats'."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/IT020>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/IT020>;
    skos:notation "DomicilieStatus".
<https://data.vlaanderen.be/id/conceptscheme/IT020> a skos:ConceptScheme;
    skos:prefLabel "Codelijst IT020"@nl;
    skos:definition "Codelijst van Informatie Type 020 'Adres van de hoofdverblijfplaats'."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/MAGDA/Persoon>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/MAGDA/Persoon>;
    skos:notation "IT020".
<https://data.vlaanderen.be/id/conceptscheme/MAGDA/Persoon> a skos:ConceptScheme;
    skos:prefLabel "Codelijsten Implementatiemodel MAGDA Persoon"@nl;
    skos:definition "Codelijsten toegepast in de implementatie van Persoon bij MAGDA volgens het Implementatiemodel MAGDA Persoon."@nl;
    skos:notation "MAGDA-Persoon".
